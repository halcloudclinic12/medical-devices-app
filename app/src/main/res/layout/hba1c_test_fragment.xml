<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="com.test.healthbox_app.BleConnectionViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- User Details view -->
        <com.test.healthbox_app.presentation.view.UserInfoView
            android:id="@+id/userInfoView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_marginVertical="30dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.test.healthbox_app.presentation.view.DeviceStatusLayout
            android:id="@+id/deviceStatusLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Reference for the meter's own error codes (E-0..E-8, HI, LO, etc.) — the
             device only ever shows these on its LCD, never over Bluetooth, so this is
             the operator's lookup when the app can't say what went wrong. -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/button_hba1c_help"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hba1c_help_title"
            android:src="@drawable/ic_info"
            app:layout_constraintEnd_toEndOf="@+id/deviceStatusLayout"
            app:layout_constraintTop_toBottomOf="@+id/deviceStatusLayout" />

        <!-- Left: device illustration -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_image_sample"
            android:layout_width="0dp"
            android:layout_height="450dp"
            android:layout_marginStart="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/layout_hba1c_readings"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/userInfoView">

            <ImageView
                android:id="@+id/iv_hba1c_icon"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:contentDescription="@string/hba1c_title"
                android:src="@drawable/ic_hba1c"
                app:layout_constraintBottom_toTopOf="@+id/tv_hba1c_status"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Live connection / progress message. The HbA1c cycle runs for several
                 minutes, so the operator needs explicit feedback that the app is
                 still listening rather than an indefinite spinner. -->
            <TextView
                android:id="@+id/tv_hba1c_status"
                style="@style/SubTextStyle18"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/hba1c_status_idle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_hba1c_icon" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Right: instructions, then result -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_hba1c_readings"
            android:layout_width="0dp"
            android:layout_height="450dp"
            android:layout_marginEnd="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/layout_image_sample"
            app:layout_constraintTop_toBottomOf="@+id/userInfoView">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_hba1c_instructions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_first_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/box_container_bg"
                    app:layout_constraintBottom_toTopOf="@+id/layout_second_step"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tv_step_one_title"
                        style="@style/ResultTextStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Step 1:"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_step_one_description"
                        style="@style/ResultLabelTextStyle"
                        android:layout_width="0dip"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_marginVertical="10dp"
                        android:text="@string/hba1c_step_one"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_step_one_title"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_second_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/box_container_bg"
                    app:layout_constraintBottom_toTopOf="@+id/layout_third_step"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_first_step">

                    <TextView
                        android:id="@+id/tv_step_two_title"
                        style="@style/ResultTextStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Step 2:"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_step_two_description"
                        style="@style/ResultLabelTextStyle"
                        android:layout_width="0dip"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_marginVertical="10dp"
                        android:text="@string/hba1c_step_two"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_step_two_title"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_third_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/box_container_bg"
                    app:layout_constraintBottom_toTopOf="@+id/layout_fourth_step"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_second_step">

                    <TextView
                        android:id="@+id/tv_step_three_title"
                        style="@style/ResultTextStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Step 3:"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_step_three_description"
                        style="@style/ResultLabelTextStyle"
                        android:layout_width="0dip"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_marginVertical="10dp"
                        android:text="@string/hba1c_step_three"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_step_three_title"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_fourth_step"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/box_container_bg"
                    app:layout_constraintBottom_toTopOf="@+id/button_start"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_third_step">

                    <TextView
                        android:id="@+id/tv_step_four_title"
                        style="@style/ResultTextStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Step 4:"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_step_four_description"
                        style="@style/ResultLabelTextStyle"
                        android:layout_width="0dip"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_marginVertical="10dp"
                        android:text="@string/hba1c_step_four"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_step_four_title"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/button_start"
                    style="@style/SmallButtonTextStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/button_style"
                    android:text="@string/start"
                    android:textAllCaps="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Result panel — shown only once a valid record has been decoded -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_hba1c_result"
                android:layout_width="0dp"
                android:layout_height="450dp"
                android:visibility="invisible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_hba1c_reading_box"
                    android:layout_width="280dp"
                    android:layout_height="300dp"
                    android:background="@drawable/box_container_bg"
                    app:layout_constraintBottom_toTopOf="@+id/button_retest"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Device-driven value: not focusable, the meter is the source of truth -->
                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/edit_hba1c"
                        style="@style/ResultTextStyle"
                        android:layout_width="match_parent"
                        android:layout_height="160dp"
                        android:background="@android:color/transparent"
                        android:focusable="false"
                        android:gravity="center"
                        android:hint="@string/hba1c_unit_ngsp"
                        android:inputType="numberDecimal"
                        android:maxEms="5"
                        android:text=""
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_hba1c_unit"
                        style="@style/SubTextStyle20"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/hba1c_unit_ngsp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/edit_hba1c" />

                    <TextView
                        android:id="@+id/tv_hba1c_result"
                        style="@style/SubTextStyle18"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text=""
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_hba1c_unit" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/button_retest"
                    style="@style/ButtonTextStyle"
                    android:layout_width="220dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/button_style"
                    android:text="@string/retest"
                    android:textAllCaps="false"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@+id/layout_hba1c_reading_box"
                    app:layout_constraintStart_toStartOf="@+id/layout_hba1c_reading_box"
                    app:layout_constraintTop_toBottomOf="@+id/layout_hba1c_reading_box" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/button_next_layout"
            style="@style/ButtonTextStyle"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="50dp"
            android:background="@drawable/button_next_style"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_hba1c_readings">

            <TextView
                android:id="@+id/tv_next"
                style="@style/SubTextStyle20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/next"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/imageView7"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imageView7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:src="@drawable/ic_arrow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tv_next"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
