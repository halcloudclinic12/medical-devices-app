<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <variable
            name="viewModel"
            type="com.test.healthbox_app.presentation.onboarding.checkin.MachineCheckInViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_login_gradient">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/iv_hal_logo"
                    android:layout_width="220dp"
                    android:layout_height="94dp"
                    android:layout_marginTop="28dp"
                    android:src="@drawable/hal_logo_square"
                    android:tag="hal_logo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/card_outer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="@drawable/bg_outer_card"
                    android:elevation="6dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="28dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/iv_hal_logo"
                    app:layout_constraintVertical_bias="0"
                    app:layout_constraintWidth_max="520dp">

                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/roboto_regular"
                        android:gravity="center"
                        android:text="@string/enter_your_machine_s_unique_id_below_to_access_the_system"
                        android:textColor="@color/patient_login_muted_text"
                        android:textSize="14sp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/machine_id_text_field"
                        style="@style/Widget.App.TextInputLayout.Outlined.Purple"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:hint="@string/machine_id"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/machine_id_text_input"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:fontFamily="@font/roboto_regular"
                            android:includeFontPadding="false"
                            android:inputType="textPersonName"
                            android:textColor="@color/patient_login_heading_text"
                            android:textSize="14sp"
                            android:text="@={viewModel.machineId}" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/machine_password_text_field"
                        style="@style/Widget.App.TextInputLayout.Outlined.Purple"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/machine_password"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusTopStart="14dp"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="@color/patient_login_muted_text">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/machine_password_text_input"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:fontFamily="@font/roboto_regular"
                            android:includeFontPadding="false"
                            android:inputType="textPassword"
                            android:textColor="@color/patient_login_heading_text"
                            android:textSize="14sp"
                            android:text="@={viewModel.machinePassword}" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/button_submit"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_btn_outline"
                        android:fontFamily="@font/roboto_semibold"
                        android:text="@string/machine_checkin_verify_cta"
                        android:textAllCaps="false"
                        android:textColor="@color/app_color"
                        android:textSize="13sp" />

                    <!-- Clinic-verified confirmation, shown once the API returns a match -->
                    <LinearLayout
                        android:id="@+id/clinic_confirmation_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_confirmation_card"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:background="@drawable/bg_circle_green">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_check"
                                    app:tint="@color/white" />

                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto_semibold"
                                    android:letterSpacing="0.05"
                                    android:text="@string/machine_checkin_verified_label"
                                    android:textAllCaps="true"
                                    android:textColor="@color/green"
                                    android:textSize="10sp" />

                                <TextView
                                    android:id="@+id/machine_name_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:fontFamily="@font/roboto_bold"
                                    android:text=""
                                    android:textColor="@color/patient_login_heading_text"
                                    android:textSize="16sp" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/roboto_regular"
                            android:text="@string/machine_checkin_confirm_subtext"
                            android:textColor="@color/patient_login_muted_text"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/button_check_in"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/button_style"
                        android:fontFamily="@font/roboto_semibold"
                        android:text="@string/machine_checkin_cta"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:visibility="gone" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
