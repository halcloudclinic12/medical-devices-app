<?xml version="1.0" encoding="utf-8"?>
<!-- Date chip - same height/pill style as the report-type chips
     (reports_types_llayout_row.xml) since they now share one row. Background/text
     color are toggled in ReportsDatesListAdapter.bind() - filled teal for the
     currently selected report's date, outline otherwise. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_date"
    android:layout_width="72dp"
    android:layout_height="40dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_btn_outline"
    tools:ignore="MissingDefaultResource">

    <TextView
        android:id="@+id/tv_date"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="@font/roboto_semibold"
        android:gravity="center"
        android:textAllCaps="false"
        android:textColor="@color/app_color"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="10 Dec" />

</androidx.constraintlayout.widget.ConstraintLayout>
