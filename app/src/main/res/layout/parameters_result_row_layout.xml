<?xml version="1.0" encoding="utf-8"?>
<!-- Card row: per-parameter icon, name + color-coded status chip on top, big value and
     muted range underneath. tv_result keeps its ORIGINAL role (the adapter only ever calls
     setText/setTextColor on it) - it just now lives inside a pill background so the
     runtime-set color reads as a status chip instead of plain colored text. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_metric_tile"
    android:padding="14dp"
    tools:ignore="MissingDefaultResource">

    <FrameLayout
        android:id="@+id/iv_parameter_icon_wrap"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle_teal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_parameter_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_health_checkup" />

    </FrameLayout>

    <TextView
        android:id="@+id/tv_parameter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/roboto_semibold"
        android:text="Parameter"
        android:textColor="@color/patient_login_heading_text"
        android:textSize="14sp"
        app:layout_constraintEnd_toStartOf="@+id/tv_result"
        app:layout_constraintStart_toEndOf="@+id/iv_parameter_icon_wrap"
        app:layout_constraintTop_toTopOf="@+id/iv_parameter_icon_wrap" />

    <TextView
        android:id="@+id/tv_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_pill_tint"
        android:fontFamily="@font/roboto_bold"
        android:minWidth="28dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="Result"
        android:textAllCaps="true"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_parameter_icon_wrap" />

    <TextView
        android:id="@+id/tv_value"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/roboto_bold"
        android:text="Value"
        android:textColor="@color/app_color"
        android:textSize="19sp"
        app:layout_constraintEnd_toStartOf="@+id/tv_range"
        app:layout_constraintStart_toEndOf="@+id/iv_parameter_icon_wrap"
        app:layout_constraintTop_toBottomOf="@+id/tv_parameter" />

    <TextView
        android:id="@+id/tv_range"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/roboto_regular"
        android:gravity="end"
        android:text="Range"
        android:textColor="@color/patient_login_muted_text"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_value"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
