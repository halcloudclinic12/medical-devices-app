<?xml version="1.0" encoding="utf-8"?>
<!-- One orbital node in the steps dialog (see dialog_steps_orbit.xml / StepsOrbitDialog).
     Inflated into a fixed nodeSlot1..8 FrameLayout, which already carries the circular
     position — this layout only supplies content and per-status color. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/nodeCircle"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:background="@drawable/bg_orbit_node_pending"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvNodeNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/roboto_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/step_title_color"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="03" />

        <TextView
            android:id="@+id/tvNodeCheck"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_orbit_check_badge"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="✓"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvNodeTitle"
        android:layout_width="84dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="@font/roboto_regular"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/step_title_color"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nodeCircle"
        tools:text="Pulse Oximeter" />

    <TextView
        android:id="@+id/tvNodeStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/roboto_regular"
        android:textSize="9sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNodeTitle"
        tools:text="Next" />

</androidx.constraintlayout.widget.ConstraintLayout>