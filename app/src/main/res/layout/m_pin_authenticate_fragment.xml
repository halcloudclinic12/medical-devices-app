<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <variable
            name="viewModel"
            type="com.test.healthbox_app.presentation.onboarding.mPin.MPinAuthenticateViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_login_gradient">

        <ImageView
            android:id="@+id/hal_logo"
            android:layout_width="200dp"
            android:layout_height="86dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/hal_logo_square"
            app:layout_constraintBottom_toTopOf="@+id/card_outer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <!-- Auth card - same bg_outer_card/padding language as Calibration's form
             card, but width-capped and center-aligned rather than full-width/
             left-aligned, since PIN entry is a compact, centered task rather than a
             multi-field form. -->
        <LinearLayout
            android:id="@+id/card_outer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_outer_card"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/hal_logo"
            app:layout_constraintWidth_max="440dp">

            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_circle_teal">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/app_color" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/roboto_semibold"
                android:letterSpacing="0.05"
                android:text="@string/mpin_badge"
                android:textAllCaps="true"
                android:textColor="@color/app_color"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/roboto_bold"
                android:gravity="center"
                android:text="@string/mpin_heading"
                android:textColor="@color/patient_login_heading_text"
                android:textSize="22sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/roboto_regular"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="@string/mpin_subtext"
                android:textColor="@color/patient_login_muted_text"
                android:textSize="13sp" />

            <com.noobcode.otpview.OTPView
                android:id="@+id/otpView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@={viewModel.mPin}"
                app:borderThickness="2"
                app:otpLayoutColor="@color/app_color"
                app:otpLayoutType="0"
                app:otpLength="6"
                app:spaceBetween="16" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_submit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_btn_teal"
                android:fontFamily="@font/roboto_semibold"
                android:text="@string/submit_text"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
