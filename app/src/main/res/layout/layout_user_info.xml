<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/user_info_card"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_solid_card"
    android:elevation="3dp"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp"
    tools:ignore="MissingDefaultResource">

    <FrameLayout
        android:id="@+id/avatar_frame"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_avatar_ring"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_user_icon"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/male_icon" />

        <View
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_online_dot" />

    </FrameLayout>

    <TextView
        android:id="@+id/tv_patient_name_age"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/roboto_bold"
        android:text=""
        android:textColor="@color/patient_login_heading_text"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/tv_patient_gender"
        app:layout_constraintStart_toEndOf="@+id/avatar_frame"
        app:layout_constraintTop_toTopOf="@+id/avatar_frame"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="John Doe | 25 Years" />

    <TextView
        android:id="@+id/tv_patient_gender"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="3dp"
        android:background="@drawable/bg_pill_tint"
        android:fontFamily="@font/roboto_medium"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:text=""
        android:textColor="@color/patient_login_label"
        android:textSize="9sp"
        app:layout_constraintBottom_toBottomOf="@+id/avatar_frame"
        app:layout_constraintStart_toEndOf="@+id/avatar_frame"
        app:layout_constraintTop_toBottomOf="@+id/tv_patient_name_age"
        tools:text="Male" />

</androidx.constraintlayout.widget.ConstraintLayout>
