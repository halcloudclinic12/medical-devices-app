        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:fontFamily">@font/roboto_condensed_black</item>
        <item name="android:background">@android:color/transparent</item>
    </style>


    <style name="Widget.App.TextInputLayout.Outlined" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_input_box_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="android:textColorHint">@color/gray_600</item>
    </style>

    <style name="Widget.App.TextInputLayout.Outlined.Purple" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/app_color</item>
        <item name="boxStrokeWidth">2dp</item>
        <item name="hintTextColor">@color/app_color</item>

        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">20sp</item>
        <item name="android:padding">5dp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:fontFamily">@font/roboto_regular</item>

    </style>

    <style name="ButtonTextStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:padding">5dp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="SmallButtonTextStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/roboto_bold</item>
        <item name="android:padding">2dp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:lineSpacingExtra">1dp</item>
        <item name="android:background">@android:color/transparent</item>
    </style>


    <style name="CustomDatePickerTheme" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <!-- Header color -->
        <item name="colorPrimary">@color/app_color</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <!-- Calendar background -->
        <item name="materialCalendarStyle">@style/CustomCalendarStyle</item>
    </style>

    <style name="CustomCalendarStyle" parent="Widget.MaterialComponents.MaterialCalendar">
        <item name="android:background">@color/white</item>
    </style>

</resources>

