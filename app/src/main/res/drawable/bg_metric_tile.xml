<?xml version="1.0" encoding="utf-8"?>
<!-- Small white result-grid tile (Body Analysis metrics grid) - distinct from
     bg_pill_tint's muted teal-on-teal wash, which reads as flat/washed-out at tile scale
     since it barely contrasts against the card behind it. This is a plain white card with
     a light border, sized for a compact grid rather than the big panel cards. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/white" />
    <stroke
        android:width="1dp"
        android:color="@color/patient_login_chip_border" />
    <corners android:radius="12dp" />

</shape>
