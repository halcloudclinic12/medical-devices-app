        android:label="fragment_machine_check_in"
        tools:layout="@layout/machine_check_in_fragment">
        <action
            android:id="@+id/get_started_action"
            app:destination="@+id/disclaimer" />

        <action
            android:id="@+id/enter_m_pin_after_check_in_action"
            app:destination="@id/loginPatientNavFragment" />

