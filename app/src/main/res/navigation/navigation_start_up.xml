    </fragment>

    <fragment
        android:id="@+id/bodyAnalysisFragment"
        android:name="com.test.healthbox_app.presentation.tests.bodyAnalysis.BodyAnalysisFragment"
        android:label="BodyAnalysisFragment"
        tools:layout="@layout/body_analysis_fragment">

        <action
            android:id="@+id/next_button_vision_action"
            app:destination="@id/visionTestFragment" />

        <action
            android:id="@+id/weight_to_height_screen_nav_action"
            app:destination="@id/heightFragment" />

        <action
            android:id="@+id/weight_to_temperature_screen_nav_action"
            app:destination="@id/temperatureFragment" />

        <action
            android:id="@+id/weight_to_pulse_screen_nav_action"
            app:destination="@id/pulseFragment" />

        <action
            android:id="@+id/close_button_action_body_analysis_screen"
            app:destination="@id/dashboardFragment" />

    </fragment>

    <fragment
        android:id="@+id/visionTestFragment"
        android:name="com.test.healthbox_app.presentation.tests.vision.VisionTestFragment"
        android:label="VisionTestFragment"
        tools:layout="@layout/vision_test_fragment">

        <action
            android:id="@+id/next_button_blood_pressure_action"
            app:destination="@id/bloodPressureFragment" />

        <action
            android:id="@+id/vision_to_height_screen_nav_action"
            app:destination="@id/heightFragment" />

        <action
            android:id="@+id/vision_to_temperature_screen_nav_action"
            app:destination="@id/temperatureFragment" />

        <action
            android:id="@+id/vision_to_pulse_screen_nav_action"
            app:destination="@id/pulseFragment" />


        <action
            android:id="@+id/vision_to_weight_screen_nav_action"
            app:destination="@id/bodyAnalysisFragment" />

        <action
            android:id="@+id/close_button_action_vision_screen"
            app:destination="@id/dashboardFragment" />


    </fragment>

    <fragment
        android:id="@+id/bloodPressureFragment"
        android:name="com.test.healthbox_app.presentation.tests.bloodPressure.BloodPressureFragment"
        android:label="BloodPressureFragment"
        tools:layout="@layout/blood_pressure_fragment">

        <action
            android:id="@+id/next_button_glucose_action"
            app:destination="@id/glucoseTestFragment" />

        <action
            android:id="@+id/bp_to_height_screen_nav_action"
            app:destination="@id/heightFragment" />

        <action
            android:id="@+id/bp_to_temperature_screen_nav_action"
            app:destination="@id/temperatureFragment" />

        <action
            android:id="@+id/bp_to_pulse_screen_nav_action"
            app:destination="@id/pulseFragment" />

        <action
            android:id="@+id/bp_to_weight_screen_nav_action"
            app:destination="@id/bodyAnalysisFragment" />

        <action
            android:id="@+id/bp_to_vision_screen_nav_action"
            app:destination="@id/visionTestFragment" />

        <action
            android:id="@+id/close_button_action_blood_pressure_screen"
            app:destination="@id/dashboardFragment" />


    </fragment>

    <fragment
        android:id="@+id/glucoseTestFragment"
        android:name="com.test.healthbox_app.presentation.tests.glucose.BloodSugarTestFragment"
        android:label="GlucoseTestFragment"
        tools:layout="@layout/blood_sugar_test_fragment">

        <action
            android:id="@+id/next_button_hemoglobin_checkup_action"
            app:destination="@id/HBCheckFragment" />

        <action
            android:id="@+id/glucose_to_height_screen_nav_action"
            app:destination="@id/heightFragment" />

        <action
            android:id="@+id/glucose_to_temperature_screen_nav_action"
            app:destination="@id/temperatureFragment" />

        <action
            android:id="@+id/glucose_to_pulse_screen_nav_action"
            app:destination="@id/pulseFragment" />

        <action
            android:id="@+id/glucose_to_weight_screen_nav_action"
            app:destination="@id/bodyAnalysisFragment" />

        <action
            android:id="@+id/glucose_to_vision_screen_nav_action"
            app:destination="@id/visionTestFragment" />

        <action
            android:id="@+id/glucose_to_blood_pressure_screen_nav_action"
            app:destination="@id/bloodPressureFragment" />

        <action
            android:id="@+id/close_button_action_glucose_screen"
            app:destination="@id/dashboardFragment" />


    </fragment>

    <fragment
        android:id="@+id/hba1cTestFragment"
        android:name="com.test.healthbox_app.presentation.tests.hba1c.Hba1cTestFragment"
        android:label="Hba1cTestFragment"
        tools:layout="@layout/hba1c_test_fragment">

        <!-- popUpTo keeps the back stack from growing on every
             dashboard -> hba1c -> dashboard round trip -->
        <action
            android:id="@+id/close_button_action_hba1c_screen"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/dashboardFragment"
            app:popUpToInclusive="true" />

        <!-- popUpTo removes this screen itself from the back stack — without it, Back
             from Results would re-enter a torn-down Hba1cTestFragment, whose
             setAndObserveDeviceAvailability() re-runs on every entry and would both
             null out the result just saved (BodyCheckupPref.hba1c = null) and kick off
             a fresh BLE reconnect the user never asked for. -->
        <action
            android:id="@+id/next_button_action_hba1c_screen"
            app:destination="@id/results_fragment"
            app:popUpTo="@id/hba1cTestFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/HBCheckFragment"
        android:name="com.test.healthbox_app.presentation.tests.hbCheck.HemoglobinTestFragment"
