        <action
            android:id="@+id/clinic_logout_action"
            app:destination="@id/machine_check_in_fragment" />

        <action
            android:id="@+id/connected_devices_action"
            app:destination="@id/connected_devices_fragment" />

        <action
            android:id="@+id/calibration_devices_action"
            app:destination="@id/calibration_devices_fragment" />


    </fragment>

