    </fragment>
    <fragment
        android:id="@+id/calibration_devices_fragment"
        android:name="com.test.healthbox_app.presentation.onboarding.calibration.CalibrationDevicesFragment"
        android:label="ConnectedDevicesFragment"
        tools:layout="@layout/connected_devices_fragment">

        <action
            android:id="@+id/back_button_action_calibration_devices_screen"
            app:destination="@id/loginPatientNavFragment" />

    </fragment>
</navigation>