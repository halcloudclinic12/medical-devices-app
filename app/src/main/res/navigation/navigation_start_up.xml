            app:destination="@id/temperatureFragment" />

        <action
            android:id="@+id/close_button_action_height_screen"
            app:destination="@id/dashboardFragment" />

    </fragment>

    <fragment
        android:id="@+id/temperatureFragment"
        android:name="com.test.healthbox_app.presentation.tests.temperature.TemperatureFragment"
        android:label="TemperatureFragment"
        tools:layout="@layout/temperature_fragment">

        <action
            android:id="@+id/next_button_pulse_checkup_action"
            app:destination="@id/pulseFragment" />

        <action
            android:id="@+id/temperature_to_height_screen_nav_action"
            app:destination="@id/heightFragment" />

        <action
            android:id="@+id/close_button_action_temperature_screen"
            app:destination="@id/dashboardFragment" />


    </fragment>

    <fragment
        android:id="@+id/pulseFragment"
        android:name="com.test.healthbox_app.presentation.tests.spo2.PulseFragment"
