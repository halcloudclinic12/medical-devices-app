        <!--            app:destination="@id/glucoseTestFragment" />-->

        <!--<action
            android:id="@+id/start_health_checkup_height_action"
            app:destination="@id/glucoseTestFragment" />-->
        <!--            app:destination="@id/HBCheckFragment" />-->

        <action
            android:id="@+id/dash_to_reports_screen_action"
            app:destination="@id/reports_fragment" />

        <action
            android:id="@+id/dash_to_hba1c_screen_action"
            app:destination="@id/hba1cTestFragment" />

        <action
            android:id="@+id/dash_back_button_action"
            app:destination="@id/loginPatientNavFragment" />
    </fragment>

    <fragment
