        <action
            android:id="@+id/next_button_weight_checkup_action"
            app:destination="@id/bodyAnalysisFragment" />

        <action
            android:id="@+id/pulse_to_height_screen_nav_action"
            app:destination="@id/heightFragment" />

        <action
            android:id="@+id/pulse_to_temperature_screen_nav_action"
            app:destination="@id/temperatureFragment" />

        <action
            android:id="@+id/close_button_action_pulse_screen"
