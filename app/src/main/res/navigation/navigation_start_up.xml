        <action
            android:id="@+id/action_splash_fragment_to_MPinAuthenticateFragment"
            app:destination="@id/loginPatientNavFragment" />

        <action
            android:id="@+id/action_splash_fragment_to_login_patient"
            app:destination="@id/loginPatientNavFragment" />

    </fragment>

