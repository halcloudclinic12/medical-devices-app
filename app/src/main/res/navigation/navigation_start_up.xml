        <action
            android:id="@+id/hb_check_to_vision_screen_nav_action"
            app:destination="@id/visionTestFragment" />

        <action
            android:id="@+id/hb_check_to_blood_pressure_screen_nav_action"
            app:destination="@id/bloodPressureFragment" />

        <action
            android:id="@+id/hb_check_to_glucose_test_screen_nav_action"
            app:destination="@id/glucoseTestFragment" />

        <action
            android:id="@+id/next_button_results_action"
            app:destination="@id/results_fragment" />

        <action
            android:id="@+id/close_button_action_hb_screen"
            app:destination="@id/dashboardFragment" />


    </fragment>


    <fragment
        android:id="@+id/results_fragment"
