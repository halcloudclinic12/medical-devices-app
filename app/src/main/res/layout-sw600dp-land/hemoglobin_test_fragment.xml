        </androidx.constraintlayout.widget.ConstraintLayout>-->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_hb_image_sample"
            android:layout_width="0dp"
            android:layout_height="400dp"
            android:layout_marginStart="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/layout_hb_readings"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/stepsLayout">

            <ImageView
                android:id="@+id/imageView6"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:src="@drawable/ic_hemoglobin"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_hb_readings"
            android:layout_width="0dp"
            android:layout_height="400dp"
            android:layout_marginEnd="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toEndOf="@+id/layout_hb_image_sample"
            app:layout_constraintTop_toBottomOf="@+id/stepsLayout">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraint_result_layout"
                android:layout_width="230dp"
                android:layout_height="250dp"
                android:background="@drawable/box_container_bg"
                app:layout_constraintBottom_toTopOf="@+id/tv_message"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <!--                android:visibility="@{viewModel.deviceResponsesReceived == true ? View.GONE : View.VISIBLE }"-->

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/edit_hemoglobin_value"
                    style="@style/ResultTextStyle"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="10dp"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:inputType="numberDecimal"
                    android:maxEms="5"
                    android:text=""
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>


            <TextView
                android:id="@+id/tv_message"
                style="@style/TextMessageStyleCustomSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text=""
                android:textStyle="normal"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/button_start_test"
                app:layout_constraintEnd_toEndOf="@+id/constraint_result_layout"
                app:layout_constraintStart_toStartOf="@+id/constraint_result_layout"
                app:layout_constraintTop_toBottomOf="@+id/constraint_result_layout" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/button_start_test"
                style="@style/ButtonTextStyle"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:background="@drawable/button_style"
                android:onClick="@{()->viewModel.startHbTest()}"
                android:text="Start Test"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/constraint_result_layout"
                app:layout_constraintStart_toStartOf="@+id/constraint_result_layout"
                app:layout_constraintTop_toBottomOf="@+id/tv_message" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/button_next_layout"
            style="@style/ButtonTextStyle"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="50dp"
            android:background="@drawable/button_next_style"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_hb_readings">

            <TextView
                android:id="@+id/tv_next"
                style="@style/SubTextStyle20"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/next"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/imageView7"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imageView7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:src="@drawable/ic_arrow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toEndOf="@+id/tv_next"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>


</layout>