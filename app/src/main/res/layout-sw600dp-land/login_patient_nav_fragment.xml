<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <variable
            name="viewModel"
            type="com.test.healthbox_app.presentation.onboarding.loginPatientNav.LoginPatientNavViewModel" />
    </data>

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/drawer_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Main content -->
        <FrameLayout
            android:id="@+id/content_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_login_gradient">

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="0dp"
                    android:layout_height="?attr/actionBarSize"
                    android:background="@android:color/transparent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:navigationIcon="@drawable/ic_hamburger_dark"
                    app:popupTheme="@style/ThemeOverlay.AppCompat.Light"
                    app:title=""
                    tools:layout_editor_absoluteX="123dp" />

                <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dip"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:fillViewport="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/toolbar">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <LinearLayout
                            android:id="@+id/card_outer"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_marginStart="24dp"
                            android:layout_marginEnd="24dp"
                            android:layout_marginBottom="24dp"
                            android:background="@drawable/bg_outer_card"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:elevation="6dp"
                            android:gravity="top"
                            android:orientation="vertical"
                            android:paddingStart="44dp"
                            android:paddingEnd="44dp"
                            android:paddingBottom="44dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <ImageView
                                android:id="@+id/iv_hal_logo"
                                android:layout_width="360dp"
                                android:layout_height="110dp"
                                android:layout_gravity="center_horizontal"
                                android:contentDescription="@string/app_name"
                                android:src="@drawable/hal_logo_square" />

                            <LinearLayout
                                android:id="@+id/ll_split_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="48dp"
                                android:baselineAligned="false"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:orientation="horizontal">

                                <!-- LEFT: branding / value proposition -->
                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="32dp"
                                    android:layout_weight="0.48"
                                    android:gravity="center_vertical"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tv_checkin_badge"
                                        style="@style/TrustChipStyle"
                                        android:layout_gravity="start"
                                        android:fontFamily="@font/roboto_semibold"
                                        android:text="@string/patient_login_badge"
                                        android:textColor="@color/app_color"
                                        android:textSize="13sp" />

                                    <TextView
                                        android:id="@+id/tv_heading"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="24dp"
                                        android:fontFamily="@font/roboto_bold"
                                        android:gravity="start"
                                        android:lineSpacingExtra="3dp"
                                        android:text="@string/patient_login_heading"
                                        android:textColor="@color/patient_login_heading_text"
                                        android:textSize="36sp" />

                                    <TextView
                                        android:id="@+id/tv_subtext"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="20dp"
                                        android:fontFamily="@font/roboto_regular"
                                        android:gravity="start"
                                        android:lineSpacingExtra="6dp"
                                        android:text="@string/patient_login_subtext"
                                        android:textColor="@color/patient_login_muted_text"
                                        android:textSize="17sp" />

                                    <LinearLayout
                                        android:id="@+id/ll_trust_list"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="36dp"
                                        android:orientation="vertical">

                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:gravity="center_vertical"
                                            android:orientation="horizontal">

                                            <ImageView
                                                android:layout_width="20dp"
                                                android:layout_height="20dp"
                                                android:contentDescription="@null"
                                                android:src="@drawable/ic_check"
                                                app:tint="@color/app_color" />

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="12dp"
                                                android:fontFamily="@font/roboto_medium"
                                                android:text="@string/patient_login_badge_paperless"
                                                android:textColor="@color/patient_login_label"
                                                android:textSize="16sp" />

                                        </LinearLayout>

                                        <LinearLayout
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="22dp"
                                            android:gravity="center_vertical"
                                            android:orientation="horizontal">

                                            <ImageView
                                                android:layout_width="20dp"
                                                android:layout_height="20dp"
                                                android:contentDescription="@null"
                                                android:src="@drawable/ic_check"
                                                app:tint="@color/app_color" />

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_marginStart="12dp"
                                                android:fontFamily="@font/roboto_medium"
                                                android:text="@string/patient_login_badge_encrypted_full"
                                                android:textColor="@color/patient_login_label"
                                                android:textSize="16sp" />

                                        </LinearLayout>

                                    </LinearLayout>

                                </LinearLayout>

                                <!-- RIGHT: mobile number card -->
                                <androidx.constraintlayout.widget.ConstraintLayout
                                    android:id="@+id/constraintLayout"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.52"
                                    android:background="@drawable/bg_solid_card"
                                    android:elevation="3dp"
                                    android:padding="36dp">

                                    <TextView
                                        android:id="@+id/tv_mobile_label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/roboto_semibold"
                                        android:letterSpacing="0.05"
                                        android:text="@string/patient_login_mobile_label"
                                        android:textColor="@color/patient_login_label"
                                        android:textSize="13sp"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toTopOf="parent" />

                                    <com.google.android.material.textfield.TextInputLayout
                                        android:id="@+id/mobile_number_text_field"
                                        style="@style/Widget.App.TextInputLayout.Outlined.Purple"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="16dp"
                                        app:boxCornerRadiusBottomEnd="14dp"
                                        app:boxCornerRadiusBottomStart="14dp"
                                        app:boxCornerRadiusTopEnd="14dp"
                                        app:boxCornerRadiusTopStart="14dp"
                                        app:hintEnabled="false"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toBottomOf="@+id/tv_mobile_label"
                                        app:prefixTextAppearance="@style/PatientLoginMobilePrefixTextAppearanceLarge"
                                        app:prefixTextColor="@color/patient_login_heading_text">

                                        <com.google.android.material.textfield.TextInputEditText
                                            android:id="@+id/mobile_number_text_input"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:fontFamily="@font/roboto_regular"
                                            android:hint="@string/patient_login_mobile_placeholder"
                                            android:includeFontPadding="false"
                                            android:inputType="number"
                                            android:maxLength="10"
                                            android:text="@={viewModel.mobileNumber}"
                                            android:textColor="@color/patient_login_heading_text"
                                            android:textColorHint="@color/patient_login_muted_text"
                                            android:textSize="18sp" />

                                    </com.google.android.material.textfield.TextInputLayout>

                                    <androidx.appcompat.widget.AppCompatButton
                                        android:id="@+id/button_submit"
                                        style="@style/ButtonTextStyle"
                                        android:layout_width="match_parent"
                                        android:layout_height="64dp"
                                        android:layout_marginTop="30dp"
                                        android:background="@drawable/button_style"
                                        android:drawableEnd="@drawable/ic_arrow"
                                        android:drawablePadding="8dp"
                                        android:gravity="center"
                                        android:text="@string/patient_login_cta"
                                        android:textAllCaps="false"
                                        app:layout_constraintEnd_toEndOf="parent"
                                        app:layout_constraintStart_toStartOf="parent"
                                        app:layout_constraintTop_toBottomOf="@+id/mobile_number_text_field" />

                                </androidx.constraintlayout.widget.ConstraintLayout>

                            </LinearLayout>

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.core.widget.NestedScrollView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </FrameLayout>

        <!-- Navigation Drawer: FrameLayout owns the floating rounded-corner clip
             (reliable View-level clipping), NavigationView inside stays transparent
             and just fills it. -->
        <FrameLayout
            android:id="@+id/nav_drawer_panel"
            android:layout_width="320dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_nav_drawer_panel"
            android:clipToOutline="true"
            android:elevation="18dp">

            <com.google.android.material.navigation.NavigationView
                android:id="@+id/navigationView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                app:headerLayout="@layout/nav_header"
                app:itemIconPadding="16dp"
                app:itemIconSize="22dp"
                app:itemIconTint="@color/nav_item_color"
                app:itemShapeAppearance="@style/ShapeAppearance.NavDrawer.Item"
                app:itemShapeFillColor="@color/patient_login_chip_bg"
                app:itemShapeInsetBottom="4dp"
                app:itemShapeInsetEnd="12dp"
                app:itemShapeInsetStart="12dp"
                app:itemShapeInsetTop="4dp"
                app:itemTextColor="@color/nav_item_color"
                app:menu="@menu/nav_drawer_menu" />

        </FrameLayout>

    </androidx.drawerlayout.widget.DrawerLayout>
</layout>
