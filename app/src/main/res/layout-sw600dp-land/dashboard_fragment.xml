<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <variable
            name="viewModel"
            type="com.test.healthbox_app.presentation.dashboard.DashboardViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_login_gradient">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/card_outer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="24dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_outer_card"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:elevation="6dp"
                    android:gravity="top"
                    android:orientation="vertical"
                    android:padding="32dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Patient profile chip -->
                    <com.test.healthbox_app.presentation.view.UserInfoView
                        android:id="@+id/userInfoView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start" />

                    <!-- Section heading -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:fontFamily="@font/roboto_bold"
                        android:text="@string/dash_section_heading"
                        android:textColor="@color/patient_login_heading_text"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/roboto_regular"
                        android:text="@string/dash_section_subtext"
                        android:textColor="@color/patient_login_muted_text"
                        android:textSize="14sp" />

                    <!-- Feature cards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:baselineAligned="false"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal">

                        <!-- Body Checkup (featured) -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/health_checkup_layout"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_card_featured"
                            android:clipToOutline="true"
                            android:elevation="4dp">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_card_accent_top"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <TextView
                                android:id="@+id/tv_badge_checkup"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="22dp"
                                android:layout_marginEnd="18dp"
                                android:background="@drawable/bg_badge_featured"
                                android:fontFamily="@font/roboto_semibold"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="5dp"
                                android:text="@string/dash_body_checkup_badge"
                                android:textColor="@color/orbit_next"
                                android:textSize="11sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <FrameLayout
                                android:id="@+id/icon_frame_checkup"
                                android:layout_width="88dp"
                                android:layout_height="88dp"
                                android:layout_marginTop="26dp"
                                android:background="@drawable/bg_circle_teal"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_badge_checkup">

                                <ImageView
                                    android:id="@+id/iv_health_checkup"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_health_checkup"
                                    app:tint="@color/app_color" />

                            </FrameLayout>

                            <TextView
                                android:id="@+id/tv_checkup_title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="center"
                                android:text="@string/dash_body_checkup_title"
                                android:textColor="@color/patient_login_heading_text"
                                android:textSize="19sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/icon_frame_checkup" />

                            <TextView
                                android:id="@+id/tv_checkup_description"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:layout_marginHorizontal="20dp"
                                android:fontFamily="@font/roboto_regular"
                                android:gravity="center"
                                android:text="@string/dash_body_checkup_description"
                                android:textColor="@color/patient_login_muted_text"
                                android:textSize="13sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_checkup_title" />

                            <LinearLayout
                                android:id="@+id/chip_row_checkup"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:orientation="horizontal"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_checkup_description">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:background="@drawable/bg_pill_tint"
                                    android:fontFamily="@font/roboto_medium"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp"
                                    android:text="@string/dash_body_checkup_chip_1"
                                    android:textColor="@color/patient_login_label"
                                    android:textSize="11sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_pill_tint"
                                    android:fontFamily="@font/roboto_medium"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp"
                                    android:text="@string/dash_body_checkup_chip_2"
                                    android:textColor="@color/patient_login_label"
                                    android:textSize="11sp" />

                            </LinearLayout>

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/button_start_checkup"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginHorizontal="20dp"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="20dp"
                                android:background="@drawable/bg_btn_amber"
                                android:fontFamily="@font/roboto_semibold"
                                android:text="@string/dash_body_checkup_cta"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/chip_row_checkup"
                                app:layout_constraintVertical_bias="1" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- HbA1C Test -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/hba1c_layout"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="12dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_solid_card"
                            android:clipToOutline="true"
                            android:elevation="3dp"
                            android:visibility="visible">

                            <TextView
                                android:id="@+id/tv_badge_hba1c"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="22dp"
                                android:layout_marginEnd="18dp"
                                android:background="@drawable/bg_pill_tint"
                                android:fontFamily="@font/roboto_semibold"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="5dp"
                                android:text="@string/dash_hba1c_badge"
                                android:textColor="@color/patient_login_label"
                                android:textSize="11sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <FrameLayout
                                android:id="@+id/icon_frame_hba1c"
                                android:layout_width="88dp"
                                android:layout_height="88dp"
                                android:layout_marginTop="26dp"
                                android:background="@drawable/bg_circle_amber"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_badge_hba1c">

                                <ImageView
                                    android:id="@+id/iv_hba1c"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_hba1c"
                                    app:tint="@color/orbit_next" />

                            </FrameLayout>

                            <TextView
                                android:id="@+id/tv_hba1c"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="center"
                                android:text="@string/dash_hba1c_title"
                                android:textColor="@color/patient_login_heading_text"
                                android:textSize="19sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/icon_frame_hba1c" />

                            <TextView
                                android:id="@+id/tv_hba1c_description"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:layout_marginHorizontal="20dp"
                                android:fontFamily="@font/roboto_regular"
                                android:gravity="center"
                                android:text="@string/dash_hba1c_description"
                                android:textColor="@color/patient_login_muted_text"
                                android:textSize="13sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_hba1c" />

                            <LinearLayout
                                android:id="@+id/chip_row_hba1c"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:orientation="horizontal"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_hba1c_description">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:background="@drawable/bg_pill_tint"
                                    android:fontFamily="@font/roboto_medium"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp"
                                    android:text="@string/dash_hba1c_chip_1"
                                    android:textColor="@color/patient_login_label"
                                    android:textSize="11sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_pill_tint"
                                    android:fontFamily="@font/roboto_medium"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp"
                                    android:text="@string/dash_hba1c_chip_2"
                                    android:textColor="@color/patient_login_label"
                                    android:textSize="11sp" />

                            </LinearLayout>

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/button_start_hba1c"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginHorizontal="20dp"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="20dp"
                                android:background="@drawable/bg_btn_teal"
                                android:fontFamily="@font/roboto_semibold"
                                android:text="@string/dash_hba1c_cta"
                                android:textAllCaps="false"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/chip_row_hba1c"
                                app:layout_constraintVertical_bias="1" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <!-- Reports -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/report_layout"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_solid_card"
                            android:clipToOutline="true"
                            android:elevation="3dp">

                            <TextView
                                android:id="@+id/tv_badge_reports"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="22dp"
                                android:layout_marginEnd="18dp"
                                android:background="@drawable/bg_pill_tint"
                                android:fontFamily="@font/roboto_semibold"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="5dp"
                                android:text="@string/dash_reports_badge"
                                android:textColor="@color/patient_login_label"
                                android:textSize="11sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <FrameLayout
                                android:id="@+id/icon_frame_reports"
                                android:layout_width="88dp"
                                android:layout_height="88dp"
                                android:layout_marginTop="26dp"
                                android:background="@drawable/bg_circle_blue"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_badge_reports">

                                <ImageView
                                    android:id="@+id/iv_reports"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_reports"
                                    app:tint="@color/active_step" />

                            </FrameLayout>

                            <TextView
                                android:id="@+id/tv_reports"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="center"
                                android:text="@string/dash_reports_title"
                                android:textColor="@color/patient_login_heading_text"
                                android:textSize="19sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/icon_frame_reports" />

                            <TextView
                                android:id="@+id/tv_reports_description"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:layout_marginHorizontal="20dp"
                                android:fontFamily="@font/roboto_regular"
                                android:gravity="center"
                                android:text="@string/dash_reports_description"
                                android:textColor="@color/patient_login_muted_text"
                                android:textSize="13sp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_reports" />

                            <LinearLayout
                                android:id="@+id/chip_row_reports"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:orientation="horizontal"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tv_reports_description">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:background="@drawable/bg_pill_tint"
                                    android:fontFamily="@font/roboto_medium"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp"
                                    android:text="@string/dash_reports_chip_1"
                                    android:textColor="@color/patient_login_label"
                                    android:textSize="11sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_pill_tint"
                                    android:fontFamily="@font/roboto_medium"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="5dp"
                                    android:text="@string/dash_reports_chip_2"
                                    android:textColor="@color/patient_login_label"
                                    android:textSize="11sp" />

                            </LinearLayout>

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/button_view_reports"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginHorizontal="20dp"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="20dp"
                                android:background="@drawable/bg_btn_outline"
                                android:fontFamily="@font/roboto_semibold"
                                android:text="@string/dash_reports_cta"
                                android:textAllCaps="false"
                                android:textColor="@color/app_color"
                                android:textSize="14sp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/chip_row_reports"
                                app:layout_constraintVertical_bias="1" />

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
