<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <import type="android.view.View" />

        <variable
            name="viewModel"
            type="com.test.healthbox_app.BleConnectionViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_login_gradient">

        <!-- Unlike other redesigned screens, button_next_layout here is a separate fixed
             footer (not nested inside the scrolling content), so this NestedScrollView
             needs explicit constraints pinning it above that button - otherwise its
             match_parent height would extend the full screen and overlap the fixed
             button instead of sitting above it. -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@+id/button_next_layout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false">

                <!-- Header row: userInfoView + deviceStatusLayout + the meter's own
                     error-code lookup (buttonHba1cHelp), which has no StepsLayout
                     equivalent since this is a standalone flow, not part of the Basic
                     checkup steps. -->
                <LinearLayout
                    android:id="@+id/header_row"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="24dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.test.healthbox_app.presentation.view.UserInfoView
                        android:id="@+id/userInfoView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <com.test.healthbox_app.presentation.view.DeviceStatusLayout
                        android:id="@+id/deviceStatusLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/button_hba1c_help"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/hba1c_help_title"
                        android:src="@drawable/ic_info" />

                </LinearLayout>

                <!-- Two-panel measurement card -->
                <LinearLayout
                    android:id="@+id/card_outer"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="24dp"
                    android:layout_marginBottom="24dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/header_row">

                    <!-- LEFT: meter illustration + live connection/progress status.
                         ivHba1cIcon has its own onClick (setupButtons()) that manually
                         flips instructions -> result, so it stays a directly-tappable
                         ImageView rather than nested inside a decorative wrapper. -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_image_sample"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="0.46"
                        android:background="@drawable/bg_solid_card"
                        android:clipToOutline="true"
                        android:elevation="3dp">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_card_accent_top_teal"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:orientation="vertical"
                            android:padding="22dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_semibold"
                                android:letterSpacing="0.05"
                                android:text="@string/hba1c_meter_eyebrow"
                                android:textAllCaps="true"
                                android:textColor="@color/patient_login_label"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/roboto_bold"
                                android:text="@string/hba1c_title"
                                android:textColor="@color/patient_login_heading_text"
                                android:textSize="22sp" />

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:gravity="center">

                                <FrameLayout
                                    android:layout_width="140dp"
                                    android:layout_height="140dp"
                                    android:layout_gravity="center"
                                    android:background="@drawable/bg_circle_teal">

                                    <ImageView
                                        android:id="@+id/iv_hba1c_icon"
                                        android:layout_width="82dp"
                                        android:layout_height="82dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="@string/hba1c_title"
                                        android:src="@drawable/ic_hba1c" />

                                </FrameLayout>

                            </FrameLayout>

                            <!-- Live connection / progress message. The HbA1c cycle runs
                                 for several minutes, so the operator needs explicit
                                 feedback that the app is still listening rather than an
                                 indefinite spinner. -->
                            <TextView
                                android:id="@+id/tv_hba1c_status"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:fontFamily="@font/roboto_regular"
                                android:gravity="center"
                                android:text="@string/hba1c_status_idle"
                                android:textColor="@color/patient_login_muted_text"
                                android:textSize="14sp" />

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- RIGHT: toggles between guidance (layoutHba1cInstructions,
                         visible by default) and the decoded result
                         (layoutHba1cResult, invisible by default) - both containers'
                         visibility is fully owned by Kotlin (showResult(),
                         showStartOrRetest(), the manual ivHba1cIcon toggle), so neither
                         is wrapped in anything that would also need toggling. -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/layout_hba1c_readings"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="0.54"
                        android:background="@drawable/bg_solid_card"
                        android:clipToOutline="true"
                        android:elevation="3dp">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_card_accent_top_teal"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/layout_hba1c_instructions"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="visible"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:orientation="vertical"
                                android:padding="22dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto_semibold"
                                    android:letterSpacing="0.05"
                                    android:text="@string/hba1c_guidance_eyebrow"
                                    android:textAllCaps="true"
                                    android:textColor="@color/patient_login_label"
                                    android:textSize="12sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="@font/roboto_bold"
                                    android:text="@string/hba1c_guidance_heading"
                                    android:textColor="@color/patient_login_heading_text"
                                    android:textSize="22sp" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_marginTop="16dp"
                                    android:layout_weight="1"
                                    android:gravity="center_vertical"
                                    android:orientation="vertical">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">

                                        <FrameLayout
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:background="@drawable/bg_circle_teal">

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:fontFamily="@font/roboto_bold"
                                                android:text="1"
                                                android:textColor="@color/app_color"
                                                android:textSize="12sp" />

                                        </FrameLayout>

                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="12dp"
                                            android:layout_weight="1"
                                            android:fontFamily="@font/roboto_semibold"
                                            android:text="@string/hba1c_step_one"
                                            android:textColor="@color/patient_login_heading_text"
                                            android:textSize="14sp" />

                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:orientation="horizontal">

                                        <FrameLayout
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:background="@drawable/bg_circle_teal">

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:fontFamily="@font/roboto_bold"
                                                android:text="2"
                                                android:textColor="@color/app_color"
                                                android:textSize="12sp" />

                                        </FrameLayout>

                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="12dp"
                                            android:layout_weight="1"
                                            android:fontFamily="@font/roboto_semibold"
                                            android:text="@string/hba1c_step_two"
                                            android:textColor="@color/patient_login_heading_text"
                                            android:textSize="14sp" />

                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:orientation="horizontal">

                                        <FrameLayout
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:background="@drawable/bg_circle_teal">

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:fontFamily="@font/roboto_bold"
                                                android:text="3"
                                                android:textColor="@color/app_color"
                                                android:textSize="12sp" />

                                        </FrameLayout>

                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="12dp"
                                            android:layout_weight="1"
                                            android:fontFamily="@font/roboto_semibold"
                                            android:text="@string/hba1c_step_three"
                                            android:textColor="@color/patient_login_heading_text"
                                            android:textSize="14sp" />

                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="12dp"
                                        android:orientation="horizontal">

                                        <FrameLayout
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:background="@drawable/bg_circle_teal">

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:fontFamily="@font/roboto_bold"
                                                android:text="4"
                                                android:textColor="@color/app_color"
                                                android:textSize="12sp" />

                                        </FrameLayout>

                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_marginStart="12dp"
                                            android:layout_weight="1"
                                            android:fontFamily="@font/roboto_semibold"
                                            android:text="@string/hba1c_step_four"
                                            android:textColor="@color/patient_login_heading_text"
                                            android:textSize="14sp" />

                                    </LinearLayout>

                                </LinearLayout>

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/button_start"
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:layout_marginTop="16dp"
                                    android:background="@drawable/bg_btn_teal"
                                    android:fontFamily="@font/roboto_semibold"
                                    android:insetBottom="0dp"
                                    android:insetTop="0dp"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:stateListAnimator="@null"
                                    android:text="@string/start"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    android:textSize="14sp" />

                            </LinearLayout>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/layout_hba1c_result"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="invisible"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:orientation="vertical"
                                android:padding="22dp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/roboto_semibold"
                                    android:letterSpacing="0.05"
                                    android:text="@string/hba1c_reading_eyebrow"
                                    android:textAllCaps="true"
                                    android:textColor="@color/patient_login_label"
                                    android:textSize="12sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="@font/roboto_bold"
                                    android:text="@string/hba1c_reading_heading"
                                    android:textColor="@color/patient_login_heading_text"
                                    android:textSize="22sp" />

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"
                                    android:gravity="center">

                                    <androidx.constraintlayout.widget.ConstraintLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center"
                                        android:background="@drawable/bg_pill_tint"
                                        android:paddingHorizontal="22dp"
                                        android:paddingVertical="30dp">

                                        <!-- Device-driven value: not focusable, the
                                             meter is the source of truth. -->
                                        <androidx.appcompat.widget.AppCompatEditText
                                            android:id="@+id/edit_hba1c"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:background="@android:color/transparent"
                                            android:focusable="false"
                                            android:fontFamily="@font/roboto_bold"
                                            android:gravity="center"
                                            android:hint="@string/hba1c_unit_ngsp"
                                            android:inputType="numberDecimal"
                                            android:maxEms="5"
                                            android:minWidth="110dp"
                                            android:text=""
                                            android:textColor="@color/patient_login_heading_text"
                                            android:textSize="64sp"
                                            app:layout_constraintEnd_toEndOf="parent"
                                            app:layout_constraintStart_toStartOf="parent"
                                            app:layout_constraintTop_toTopOf="parent" />

                                        <TextView
                                            android:id="@+id/tv_hba1c_unit"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="2dp"
                                            android:fontFamily="@font/roboto_semibold"
                                            android:text="@string/hba1c_unit_ngsp"
                                            android:textColor="@color/patient_login_label"
                                            android:textSize="15sp"
                                            app:layout_constraintEnd_toEndOf="parent"
                                            app:layout_constraintStart_toStartOf="parent"
                                            app:layout_constraintTop_toBottomOf="@+id/edit_hba1c" />

                                        <TextView
                                            android:id="@+id/tv_hba1c_result"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="12dp"
                                            android:fontFamily="@font/roboto_semibold"
                                            android:gravity="center"
                                            android:text=""
                                            android:textColor="@color/app_color"
                                            android:textSize="16sp"
                                            app:layout_constraintEnd_toEndOf="parent"
                                            app:layout_constraintStart_toStartOf="parent"
                                            app:layout_constraintTop_toBottomOf="@+id/tv_hba1c_unit" />

                                    </androidx.constraintlayout.widget.ConstraintLayout>

                                </FrameLayout>

                                <androidx.appcompat.widget.AppCompatButton
                                    android:id="@+id/button_retest"
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:layout_marginTop="16dp"
                                    android:background="@drawable/bg_btn_teal"
                                    android:fontFamily="@font/roboto_semibold"
                                    android:insetBottom="0dp"
                                    android:insetTop="0dp"
                                    android:minWidth="0dp"
                                    android:minHeight="0dp"
                                    android:stateListAnimator="@null"
                                    android:text="@string/retest"
                                    android:textAllCaps="false"
                                    android:textColor="@color/white"
                                    android:textSize="14sp" />

                            </LinearLayout>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

        <!-- Next: always reachable regardless of instructions/result toggle state -
             matches the original's placement outside layout_hba1c_readings. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/button_next_layout"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/bg_btn_teal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tv_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_semibold"
                android:gravity="center"
                android:text="@string/next"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="17sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/imageView7"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imageView7"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_arrow"
                app:layout_constraintBottom_toBottomOf="@+id/tv_next"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_next"
                app:layout_constraintTop_toTopOf="@+id/tv_next"
                app:tint="@color/white" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
