<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="MissingDefaultResource">

    <data>

        <variable
            name="viewModel"
            type="com.test.healthbox_app.presentation.onboarding.registerPatient.RegisterPatientViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_login_gradient">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false">

                <LinearLayout
                    android:id="@+id/card_outer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="24dp"
                    android:layout_marginBottom="24dp"
                    android:background="@drawable/bg_outer_card"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:elevation="6dp"
                    android:gravity="top"
                    android:orientation="vertical"
                    android:padding="40dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/iv_hal_logo"
                        android:layout_width="300dp"
                        android:layout_height="110dp"
                        android:layout_gravity="center_horizontal"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/hal_logo_square" />

                    <LinearLayout
                        android:id="@+id/ll_split_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal">

                        <!-- LEFT: branding / value proposition -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="32dp"
                            android:layout_weight="0.42"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_register_badge"
                                style="@style/TrustChipStyle"
                                android:layout_gravity="start"
                                android:fontFamily="@font/roboto_semibold"
                                android:text="@string/patient_register_badge"
                                android:textColor="@color/app_color"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/tv_register_heading"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="24dp"
                                android:fontFamily="@font/roboto_bold"
                                android:gravity="start"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/patient_register_heading"
                                android:textColor="@color/patient_login_heading_text"
                                android:textSize="34sp" />

                            <TextView
                                android:id="@+id/tv_register_subtext"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="18dp"
                                android:fontFamily="@font/roboto_regular"
                                android:gravity="start"
                                android:lineSpacingExtra="6dp"
                                android:text="@string/patient_register_subtext"
                                android:textColor="@color/patient_login_muted_text"
                                android:textSize="17sp" />

                            <LinearLayout
                                android:id="@+id/ll_register_trust_list"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="32dp"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_check"
                                        app:tint="@color/app_color" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="12dp"
                                        android:fontFamily="@font/roboto_medium"
                                        android:text="@string/patient_register_badge_records"
                                        android:textColor="@color/patient_login_label"
                                        android:textSize="16sp" />

                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="18dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_check"
                                        app:tint="@color/app_color" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="12dp"
                                        android:fontFamily="@font/roboto_medium"
                                        android:text="@string/patient_register_badge_one_time"
                                        android:textColor="@color/patient_login_label"
                                        android:textSize="16sp" />

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                        <!-- RIGHT: patient details form -->
                        <LinearLayout
                            android:id="@+id/patient_details_card"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.58"
                            android:background="@drawable/bg_solid_card"
                            android:elevation="3dp"
                            android:orientation="vertical"
                            android:padding="32dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/roboto_semibold"
                                android:letterSpacing="0.05"
                                android:text="@string/patient_register_details_label"
                                android:textColor="@color/patient_login_label"
                                android:textSize="13sp" />

                            <!-- Patient Name -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/patient_name_til_field"
                                style="@style/Widget.App.TextInputLayout.Outlined.Purple"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="14dp"
                                app:boxCornerRadiusBottomEnd="14dp"
                                app:boxCornerRadiusBottomStart="14dp"
                                app:boxCornerRadiusTopEnd="14dp"
                                app:boxCornerRadiusTopStart="14dp"
                                app:hintEnabled="false">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/patient_name_input"
                                    android:layout_width="match_parent"
                                    android:layout_height="58dp"
                                    android:fontFamily="@font/roboto_regular"
                                    android:hint="@string/patient_register_name_placeholder"
                                    android:includeFontPadding="false"
                                    android:inputType="textPersonName"
                                    android:textColor="@color/patient_login_heading_text"
                                    android:textColorHint="@color/patient_login_muted_text"
                                    android:textSize="16sp"
                                    android:text="@={viewModel.patient.name}" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Date of Birth + Mobile Number -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/date_of_birth_til_field"
                                    style="@style/Widget.App.TextInputLayout.Outlined.Purple"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:layout_weight="1"
                                    app:boxCornerRadiusBottomEnd="14dp"
                                    app:boxCornerRadiusBottomStart="14dp"
                                    app:boxCornerRadiusTopEnd="14dp"
                                    app:boxCornerRadiusTopStart="14dp"
                                    app:endIconDrawable="@drawable/ic_chevron_down"
                                    app:endIconMode="custom"
                                    app:endIconTint="@color/patient_login_muted_text"
                                    app:hintEnabled="false">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/date_of_birth_input"
                                        android:layout_width="match_parent"
                                        android:layout_height="58dp"
                                        android:fontFamily="@font/roboto_regular"
                                        android:focusableInTouchMode="false"
                                        android:hint="@string/patient_register_dob_placeholder"
                                        android:includeFontPadding="false"
                                        android:inputType="number"
                                        android:textColor="@color/patient_login_heading_text"
                                        android:textColorHint="@color/patient_login_muted_text"
                                        android:textSize="16sp" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/mobile_number_til_field"
                                    style="@style/Widget.App.TextInputLayout.Outlined.Purple"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    app:boxCornerRadiusBottomEnd="14dp"
                                    app:boxCornerRadiusBottomStart="14dp"
                                    app:boxCornerRadiusTopEnd="14dp"
                                    app:boxCornerRadiusTopStart="14dp"
                                    app:hintEnabled="false">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/mobile_number_input"
                                        android:layout_width="match_parent"
                                        android:layout_height="58dp"
                                        android:fontFamily="@font/roboto_regular"
                                        android:hint="@string/patient_register_mobile_placeholder"
                                        android:includeFontPadding="false"
                                        android:inputType="number"
                                        android:maxLength="10"
                                        android:textColor="@color/patient_login_heading_text"
                                        android:textColorHint="@color/patient_login_muted_text"
                                        android:textSize="16sp"
                                        android:text="@={viewModel.patient.mobile}" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                            <!-- Email -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/email_til_field"
                                style="@style/Widget.App.TextInputLayout.Outlined.Purple"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                app:boxCornerRadiusBottomEnd="14dp"
                                app:boxCornerRadiusBottomStart="14dp"
                                app:boxCornerRadiusTopEnd="14dp"
                                app:boxCornerRadiusTopStart="14dp"
                                app:hintEnabled="false">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/email_input"
                                    android:layout_width="match_parent"
                                    android:layout_height="58dp"
                                    android:fontFamily="@font/roboto_regular"
                                    android:hint="@string/patient_register_email_placeholder"
                                    android:includeFontPadding="false"
                                    android:inputType="textEmailAddress"
                                    android:textColor="@color/patient_login_heading_text"
                                    android:textColorHint="@color/patient_login_muted_text"
                                    android:textSize="16sp"
                                    android:text="@={viewModel.patient.email}" />

                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Gender + Blood Group -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/genderInputLayout"
                                    style="@style/Widget.App.TextInputLayout.Outlined.Purple"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:layout_weight="1"
                                    app:boxCornerRadiusBottomEnd="14dp"
                                    app:boxCornerRadiusBottomStart="14dp"
                                    app:boxCornerRadiusTopEnd="14dp"
                                    app:boxCornerRadiusTopStart="14dp"
                                    app:endIconDrawable="@drawable/ic_chevron_down"
                                    app:endIconMode="custom"
                                    app:endIconTint="@color/patient_login_muted_text"
                                    app:hintEnabled="false">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/gender_input"
                                        android:layout_width="match_parent"
                                        android:layout_height="58dp"
                                        android:fontFamily="@font/roboto_regular"
                                        android:focusableInTouchMode="false"
                                        android:hint="@string/patient_register_gender_placeholder"
                                        android:includeFontPadding="false"
                                        android:inputType="textPersonName"
                                        android:textColor="@color/patient_login_heading_text"
                                        android:textColorHint="@color/patient_login_muted_text"
                                        android:textSize="16sp"
                                        android:text="@={viewModel.patient.gender}" />

                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/bloodGroupInputLayout"
                                    style="@style/Widget.App.TextInputLayout.Outlined.Purple"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    app:boxCornerRadiusBottomEnd="14dp"
                                    app:boxCornerRadiusBottomStart="14dp"
                                    app:boxCornerRadiusTopEnd="14dp"
                                    app:boxCornerRadiusTopStart="14dp"
                                    app:endIconDrawable="@drawable/ic_chevron_down"
                                    app:endIconMode="custom"
                                    app:endIconTint="@color/patient_login_muted_text"
                                    app:hintEnabled="false">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/blood_group_input"
                                        android:layout_width="match_parent"
                                        android:layout_height="58dp"
                                        android:fontFamily="@font/roboto_regular"
                                        android:focusableInTouchMode="false"
                                        android:hint="@string/patient_register_bloodgroup_placeholder"
                                        android:includeFontPadding="false"
                                        android:inputType="textPersonName"
                                        android:textColor="@color/patient_login_heading_text"
                                        android:textColorHint="@color/patient_login_muted_text"
                                        android:textSize="16sp"
                                        android:text="@={viewModel.patient.bloodGroup}" />

                                </com.google.android.material.textfield.TextInputLayout>

                            </LinearLayout>

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/button_submit"
                                style="@style/ButtonTextStyle"
                                android:layout_width="match_parent"
                                android:layout_height="58dp"
                                android:layout_marginTop="22dp"
                                android:background="@drawable/button_style"
                                android:drawableEnd="@drawable/ic_arrow"
                                android:drawablePadding="8dp"
                                android:gravity="center"
                                android:text="@string/patient_register_cta"
                                android:textAllCaps="false" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
