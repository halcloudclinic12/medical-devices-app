                        app:layout_constraintEnd_toStartOf="@+id/right_rb_20_40"
                        app:layout_constraintStart_toEndOf="@+id/left_rb_20_40"
                        app:layout_constraintTop_toTopOf="parent" />

                    <RadioButton
                        android:id="@+id/right_rb_20_40"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="6/12"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_20_40"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/iv_20_40"
                        app:layout_constraintTop_toTopOf="@+id/iv_20_40" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_alphabets_slide_3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_20_30"
                    android:layout_width="match_parent"
                    android:layout_height="0dip"
                    app:layout_constraintBottom_toTopOf="@+id/layout_20_25"
                    app:layout_constraintTop_toTopOf="parent">

                    <RadioButton
                        android:id="@+id/left_rb_20_30"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="6/9"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_20_30"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/iv_20_30" />

                    <ImageView
                        android:id="@+id/iv_20_30"
                        android:layout_width="0dip"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/vision_20_30_alphabets"
                        app:layout_constraintEnd_toStartOf="@+id/right_rb_20_30"
                        app:layout_constraintStart_toEndOf="@+id/left_rb_20_30"
                        app:layout_constraintTop_toTopOf="parent" />

                    <RadioButton
                        android:id="@+id/right_rb_20_30"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="6/9"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_20_30"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/iv_20_30"
                        app:layout_constraintTop_toTopOf="@+id/iv_20_30" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_20_25"
                    android:layout_width="match_parent"
                    android:layout_height="0dip"
                    app:layout_constraintBottom_toBottomOf="@+id/layout_20_20"
                    app:layout_constraintTop_toBottomOf="@+id/layout_20_30">

                    <RadioButton
                        android:id="@+id/left_rb_20_25"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="6/7.5"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_20_25"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/iv_20_25" />

                    <ImageView
                        android:id="@+id/iv_20_25"
                        android:layout_width="0dip"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/vision_20_25_alphabets"
                        app:layout_constraintEnd_toStartOf="@+id/right_rb_20_25"
                        app:layout_constraintStart_toEndOf="@+id/left_rb_20_25"
                        app:layout_constraintTop_toTopOf="parent" />

                    <RadioButton
                        android:id="@+id/right_rb_20_25"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="6/7.5"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_20_25"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/iv_20_25"
                        app:layout_constraintTop_toTopOf="@+id/iv_20_25" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_20_20"
                    android:layout_width="match_parent"
                    android:layout_height="0dip"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/layout_20_25">

                    <RadioButton
                        android:id="@+id/left_rb_20_20"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="6/6"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_20_20"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/iv_20_20" />

                    <ImageView
                        android:id="@+id/iv_20_20"
                        android:layout_width="0dip"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/vision_20_20_alphabets"
                        app:layout_constraintEnd_toStartOf="@+id/right_rb_20_20"
                        app:layout_constraintStart_toEndOf="@+id/left_rb_20_20"
                        app:layout_constraintTop_toTopOf="parent" />

                    <RadioButton
                        android:id="@+id/right_rb_20_20"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="6/6"
                        app:layout_constraintBottom_toBottomOf="@+id/iv_20_20"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/iv_20_20"
                        app:layout_constraintTop_toTopOf="@+id/iv_20_20" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/iv_next_step"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_margin="10dp"
            android:src="@drawable/ic_arrow"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/constraintLayout5"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>